METHOD Do_nAxis_Stop : BOOL
VAR_INPUT
    i : INT;
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR

IF GVL.myRobot_val.Robotic_CtrlTarg[i].IsTarg_Axis = 1 THEN
    // 清除UI相悖项目

    // Stop 控制逻辑（软停止）
    GVL.myRobot_val.nAxisControl[i].CtrlWord := 16#000F;   // Disable Operation（或软停）
    GVL.myRobot_val.nAxisControl[i].TargetVel_RPM := 0;    // 停止速度
    GVL.myRobot_val.nAxisControl[i].TargetTorque := 0;     // 停止力矩
    GVL.myRobot_val.nAxisControl[i].TargetPosReal := 0;
END_IF
