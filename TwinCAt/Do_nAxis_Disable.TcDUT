METHOD Do_nAxis_Disable : BOOL
VAR_INPUT
    i: INT;
END_VAR
VAR_OUTPUT
END_VAR
VAR

IF GVL.myRobot_val.Robotic_CtrlTarg[i].IsTarg_Axis=1 THEN
//清除UI相悖项目
GVL.UI_control.Axis_Control_CMD[0] := 0;
GVL.UI_control.Axis_Control_CMD[1] := 0;
GVL.UI_control.Axis_Control_CMD[2] := 0;

//Disable
GVL.myRobot_val.nAxisControl[i].CtrlWord := 0;
GVL.myRobot_val.nAxisControl[i].TargetPosReal := 0;
GVL.myRobot_val.nAxisControl[i].TargetTorque := 0;
GVL.myRobot_val.nAxisControl[i].TargetVel_RPM := 0;
END_IF