METHOD Do_nAxis_ResetERR : BOOL
VAR_INPUT
    i : INT;
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR

IF GVL.myRobot_val.Robotic_CtrlTarg[i].IsTarg_Axis = 1 THEN
    // 清除UI相悖项目

    // Stop 控制逻辑（软停止）
    IF GVL.myRobot_val.Robotic_CtrlTarg[Axis_id].Targ_Axis_Status = nAxis_SMT_e.ERR THEN
        GVL.myRobot_val.nAxisControl[i].CtrlWord := 128;   // 清错
        GVL.myRobot_val.nAxisControl[i].TargetVel_RPM := 0;    // 停止速度
        GVL.myRobot_val.nAxisControl[i].TargetTorque := 0;     // 停止力矩
        GVL.myRobot_val.nAxisControl[i].TargetPosReal := 0;
    END_IF
END_IF